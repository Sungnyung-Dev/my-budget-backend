NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL="mysql://budget_dev:replace_with_local_password@127.0.0.1:3306/my_budget_dev"

# 운영: .env.production.example을 .env로 복사하고 실제 값을 편집합니다.
# 마이그레이션 계정: .env.migration.example을 .env.migration으로 복사합니다.
# ENV_FILE=.env.migration npm run db:check
# ENV_FILE은 실행할 명령에만 지정하며 이 파일 안에는 넣지 않습니다.
