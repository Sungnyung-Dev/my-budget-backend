NODE_ENV=production
HOST=127.0.0.1
PORT=3004
DATABASE_URL="mysql://budget_app:replace_with_url_encoded_app_password@127.0.0.1:3306/my_budget"

# 비밀번호 해시는 반드시 작은따옴표로 감싸 $ 확장 문제를 방지하세요.
AUTH_USERNAME=budget
AUTH_PASSWORD_HASH='replace_with_scrypt_hash'
AUTH_ORIGIN=https://budget.ecoma.kro.kr

# MySQL SHA-2 콜드 인증: 아래 두 방식 중 하나만 지정합니다. 키/CA는 저장소 밖에서 관리합니다.
# 루프백 DB: 서버의 RSA 공개키를 신뢰한 경로에서 확보·검증 후 고정 (비밀번호 교환만 보호).
# DATABASE_RSA_PUBLIC_KEY_FILE=/etc/my-budget/mysql-public.pem
# 원격 DB: 호스트 이름과 인증서 SAN이 일치하는 URL + 신뢰한 CA (TLS 1.2 이상, 검증 필수).
# DATABASE_TLS_CA_FILE=/etc/my-budget/mysql-ca.pem
